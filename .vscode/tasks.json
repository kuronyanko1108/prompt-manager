{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run DB Script",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/python",
      "args": [
        "-m",
        "src.database.sqlite_db"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run Repository Script",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/python",
      "args": [
        "-m",
        "src.repositories.sqlite_prompt_repository"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
